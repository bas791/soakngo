{%- comment -%}
  Design token system. All colours, type and spacing flow from these
  custom properties — sections and components never hard-code values.
{%- endcomment -%}
<style>
  :root {
    --color-primary: {{ settings.color_primary | default: '#1a3a5c' }};
    --color-secondary: {{ settings.color_secondary | default: '#1e6fa8' }};
    --color-accent: {{ settings.color_accent | default: '#f5c518' }};
    --color-bg: {{ settings.color_background | default: '#ffffff' }};
    --color-bg-soft: {{ settings.color_background_soft | default: '#f2f6fa' }};
    --color-text: {{ settings.color_primary | default: '#1a3a5c' }};
    --color-text-soft: {{ settings.color_text_soft | default: '#4a6076' }};
    --color-line: {{ settings.color_line | default: '#d9e2ea' }};
    --color-on-primary: #ffffff;
    --color-on-accent: {{ settings.color_primary | default: '#1a3a5c' }};
    --color-success: #1e7d4f;
    --color-error: #c0392b;

    --font-display: 'Barlow Condensed', 'Arial Narrow', 'Helvetica Neue', Arial, sans-serif;
    --font-body: 'Source Sans 3', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;

    --text-display: clamp(3rem, 8vw, 5.5rem);
    --text-h1: clamp(2.4rem, 6vw, 4rem);
    --text-h2: clamp(1.9rem, 4vw, 2.75rem);
    --text-h3: clamp(1.35rem, 2.6vw, 1.75rem);
    --text-h4: 1.15rem;
    --text-body: 1rem;
    --text-small: 0.875rem;
    --text-xs: 0.78rem;

    --space-1: 0.25rem;
    --space-2: 0.5rem;
    --space-3: 0.75rem;
    --space-4: 1rem;
    --space-5: 1.5rem;
    --space-6: 2rem;
    --space-8: 3rem;
    --space-10: 4rem;
    --section-pad: clamp(3rem, 8vw, 5.5rem);

    --radius-s: 6px;
    --radius-m: 12px;
    --radius-pill: 999px;
    --shadow-s: 0 1px 3px rgba(26, 58, 92, 0.12);
    --shadow-m: 0 8px 30px rgba(26, 58, 92, 0.14);

    --container: {{ settings.container_width | default: 1200 }}px;
    --header-height: 64px;
  }
</style>
