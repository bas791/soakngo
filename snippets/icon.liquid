{%- comment -%}
  Inline SVG icon set.
  Usage: {% render 'icon', name: 'cart', size: 20 %}
{%- endcomment -%}
{%- assign s = size | default: 20 -%}
{%- case name -%}
  {%- when 'cart' -%}
    <svg class="icon icon-cart" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="9" cy="21" r="1.5"/><circle cx="19" cy="21" r="1.5"/><path d="M2 3h3l2.6 12.6a1 1 0 0 0 1 .8h9.7a1 1 0 0 0 1-.8L21.5 7H6"/></svg>
