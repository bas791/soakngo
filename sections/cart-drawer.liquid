<cart-drawer class="cart-drawer" id="CartDrawer" role="dialog" aria-modal="true" aria-label="{{ 'cart.title' | t }}" aria-hidden="true">
  <button type="button" class="drawer__overlay" tabindex="-1" aria-label="{{ 'accessibility.close' | t }}" data-drawer-close></button>
  <div class="drawer__panel">
    <div data-cart-drawer-content style="display: flex; flex-direction: column; height: 100%; min-height: 0;">
      <div class="drawer__header">
        <span class="drawer__title">{{ 'cart.title' | t }} ({{ cart.item_count }})</span>
        <button type="button" class="header-icon-btn" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">
          {% render 'icon', name: 'close', size: 24 %}
        </button>
      </div>

      {%- if cart.item_count == 0 -%}
        <div class="drawer__body">
          <div class="cart-empty">
            <h3>{{ 'cart.empty' | t }}</h3>
            <p class="muted">Your house, on the other hand, is probably not.</p>
            <a href="{{ section.settings.empty_cart_link | default: routes.all_products_collection_url }}" class="btn btn--primary" data-drawer-close>
              {{ 'cart.empty_link' | t }}
            </a>
          </div>
        </div>
      {%- else -%}
        <div class="drawer__body">
          {% render 'free-shipping-bar' %}

          <cart-items>
            {% render 'cart-line-items' %}
          </cart-items>

          {%- comment -%} In-cart upsell slot {%- endcomment -%}
          {%- assign upsell = section.settings.upsell_product -%}
          {%- if upsell != blank and upsell.available -%}
            {%- assign already_in_cart = false -%}
            {%- for item in cart.items -%}
              {%- if item.product_id == upsell.id -%}{%- assign already_in_cart = true -%}{%- endif -%}
            {%- endfor -%}
            {%- unless already_in_cart -%}
              <div class="cart-upsell">
                <div class="cart-upsell__media">
                  {%- if upsell.featured_media -%}
                    <img src="{{ upsell.featured_media | image_url: width: 120 }}" width="60" height="60" loading="lazy" alt="{{ upsell.featured_media.alt | default: upsell.title | escape }}">
                  {%- else -%}
                    {% render 'ph-image', label: upsell.title, ratio: '1x1' %}
                  {%- endif -%}
                </div>
                <div class="cart-upsell__body">
                  <p class="cart-upsell__kicker">{{ section.settings.upsell_heading }}</p>
                  <p class="cart-upsell__title">{{ upsell.title }}</p>
                  <p class="cart-upsell__price">{{ upsell.price | money }}</p>
                </div>
                <product-form>
                  <form action="{{ routes.cart_add_url }}" method="post">
                    <input type="hidden" name="id" value="{{ upsell.selected_or_first_available_variant.id }}">
                    <button type="submit" class="btn btn--secondary" style="padding: 0.5rem 1rem; min-height: 40px; font-size: 0.95rem;">
                      <span data-atc-text>Add</span>
                    </button>
                  </form>
                </product-form>
              </div>
            {%- endunless -%}
          {%- endif -%}

          {%- comment -%}
            BUNDLER APP INTEGRATION BLOCK — cart drawer.
            Bundler's cart widget (progress towards next bundle tier) renders
            inside #bundler-cart-widget below. Configure in the Bundler app.
          {%- endcomment -%}
          {%- if section.settings.show_bundler_block -%}
            <div class="bundler-block" style="margin-block: var(--space-4);">
              <div id="bundler-cart-widget" class="bundler-target"></div>
              {%- if settings.show_bundle_note and settings.bundle_note != blank -%}
                <p class="bundler-block__note">
                  {% render 'icon', name: 'plus', size: 16 %}
                  {{ settings.bundle_note }}
                </p>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

        <div class="drawer__footer">
          {%- assign has_subscription = false -%}
          {%- for item in cart.items -%}
            {%- if item.selling_plan_allocation -%}{%- assign has_subscription = true -%}{%- endif -%}
          {%- endfor -%}
          {%- if has_subscription -%}
            <p class="cart-note-sub">{% render 'icon', name: 'refresh', size: 14 %} {{ 'cart.subscription_note' | t }}</p>
          {%- endif -%}
          <div class="cart-subtotal">
            <span>{{ 'cart.subtotal' | t }}</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          <p class="small muted" style="margin-bottom: var(--space-3);">{{ 'cart.taxes_and_shipping' | t }}</p>
          <form action="{{ routes.cart_url }}" method="post">
            <button type="submit" name="checkout" class="btn btn--primary btn--full btn--large">
              {{ 'cart.checkout' | t }}
            </button>
          </form>
          <a href="{{ routes.cart_url }}" class="link-arrow" style="margin-top: var(--space-3); display: inline-flex;">
            {{ 'cart.view_cart' | t }} {% render 'icon', name: 'arrow', size: 16 %}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</cart-drawer>

{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    {
      "type": "product",
      "id": "upsell_product",
      "label": "Upsell product",
      "info": "Shown when it's not already in the cart. Recommend the 2L Refill or the next size up."
    },
    {
      "type": "text",
      "id": "upsell_heading",
      "label": "Upsell heading",
      "default": "Don't run out mid-job"
    },
    {
      "type": "checkbox",
      "id": "show_bundler_block",
      "label": "Show Bundler app block",
      "default": true
    },
    {
      "type": "url",
      "id": "empty_cart_link",
      "label": "Empty cart button link"
    }
  ]
}
{% endschema %}
