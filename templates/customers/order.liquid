<div class="container account-page">
  <p><a href="{{ routes.account_url }}" class="link-arrow">{{ 'customer.account.return' | t }}</a></p>
  <h1 style="margin-block: var(--space-4);">{{ 'customer.order.title' | t: name: order.name }}</h1>
  {%- assign order_date = order.created_at | date: '%-d %B %Y' -%}
  <p class="muted">{{ 'customer.order.date' | t: date: order_date }}</p>

  {%- if order.cancelled -%}
    <div class="form-status form-status--error" style="margin-top: var(--space-4);">
      {%- assign cancelled_date = order.cancelled_at | date: '%-d %B %Y' -%}
      <p>{{ 'customer.order.cancelled' | t: date: cancelled_date }}</p>
      <p>{{ 'customer.order.cancelled_reason' | t: reason: order.cancel_reason_label }}</p>
    </div>
  {%- endif -%}

  <div class="table-wrap" style="margin-top: var(--space-5);">
    <table class="data-table">
      <thead>
        <tr>
          <th scope="col">{{ 'customer.order.product' | t }}</th>
          <th scope="col">{{ 'customer.order.sku' | t }}</th>
          <th scope="col">{{ 'customer.order.price' | t }}</th>
          <th scope="col">{{ 'customer.order.quantity' | t }}</th>
          <th scope="col">{{ 'customer.order.total' | t }}</th>
        </tr>
      </thead>
      <tbody>
        {%- for line_item in order.line_items -%}
          <tr>
            <td>
              {%- if line_item.url -%}<a href="{{ line_item.url }}">{{ line_item.title }}</a>{%- else -%}{{ line_item.title }}{%- endif -%}
              {%- if line_item.selling_plan_allocation -%}
                <br><span class="small muted">{{ line_item.selling_plan_allocation.selling_plan.name }}</span>
              {%- endif -%}
            </td>
            <td>{{ line_item.sku }}</td>
            <td>{{ line_item.final_price | money }}</td>
            <td>{{ line_item.quantity }}</td>
            <td>{{ line_item.final_line_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
      <tfoot>
        <tr>
          <td colspan="4">{{ 'customer.order.subtotal' | t }}</td>
          <td>{{ order.line_items_subtotal_price | money }}</td>
        </tr>
        {%- for shipping_method in order.shipping_methods -%}
          <tr>
            <td colspan="4">{{ 'customer.order.shipping' | t }} ({{ shipping_method.title }})</td>
            <td>{{ shipping_method.price | money }}</td>
          </tr>
        {%- endfor -%}
        {%- for tax_line in order.tax_lines -%}
          <tr>
            <td colspan="4">{{ 'customer.order.tax' | t }} ({{ tax_line.title }} {{ tax_line.rate | times: 100 }}%)</td>
            <td>{{ tax_line.price | money }}</td>
          </tr>
        {%- endfor -%}
        <tr>
          <td colspan="4"><strong>{{ 'customer.order.total' | t }}</strong></td>
          <td><strong>{{ order.total_price | money }}</strong></td>
        </tr>
      </tfoot>
    </table>
  </div>

  <div class="grid grid--2" style="margin-top: var(--space-6); align-items: start;">
    <div class="address-card">
      <h2 class="h4">{{ 'customer.order.billing_address' | t }}</h2>
      <p class="small muted">{{ order.billing_address | format_address }}</p>
    </div>
    <div class="address-card">
      <h2 class="h4">{{ 'customer.order.shipping_address' | t }}</h2>
      <p class="small muted">{{ order.shipping_address | format_address }}</p>
    </div>
  </div>
</div>
