<div class="container section">
  <div class="section-head">
    <h1>{{ 'general.search.title' | t }}</h1>
  </div>

  <form action="{{ routes.search_url }}" method="get" role="search" class="newsletter-form" style="margin-bottom: var(--space-6);">
    <div class="field">
      <label class="visually-hidden" for="SearchInput">{{ 'general.search.placeholder' | t }}</label>
      <input
        id="SearchInput"
        type="search"
        name="q"
        class="input"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'general.search.placeholder' | t }}"
      >
      <input type="hidden" name="options[prefix]" value="last">
    </div>
    <button type="submit" class="btn btn--primary">{{ 'general.search.submit' | t }}</button>
  </form>

  {%- if search.performed -%}
    {%- if search.results_count == 0 -%}
      <p class="lede">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
    {%- else -%}
      <p class="muted" style="margin-bottom: var(--space-5);">
        {{ 'general.search.results_with_count' | t: count: search.results_count, terms: search.terms }}
      </p>
      {%- paginate search.results by 12 -%}
        <div class="collection-grid">
          {%- for item in search.results -%}
            {%- case item.object_type -%}
              {%- when 'product' -%}
                {% render 'product-card', product: item, show_cta: true %}
              {%- when 'article' -%}
                <article class="article-card">
                  <div class="article-card__body">
                    <p class="kicker" style="margin-bottom: 0;">Article</p>
                    <h2 class="article-card__title"><a href="{{ item.url }}">{{ item.title }}</a></h2>
                    <p>{{ item.content | strip_html | truncatewords: 24 }}</p>
                  </div>
                </article>
              {%- when 'page' -%}
                <article class="article-card">
                  <div class="article-card__body">
                    <p class="kicker" style="margin-bottom: 0;">Page</p>
                    <h2 class="article-card__title"><a href="{{ item.url }}">{{ item.title }}</a></h2>
                    <p>{{ item.content | strip_html | truncatewords: 24 }}</p>
                  </div>
                </article>
            {%- endcase -%}
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="Pagination">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">{{ 'general.pagination.previous' | t }}</a>{%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}">{{ part.title }}</a>
              {%- elsif part.title == paginate.current_page -%}
                <span aria-current="page">{{ part.title }}</span>
              {%- else -%}
                <span>{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}">{{ 'general.pagination.next' | t }}</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Search results",
  "settings": []
}
{% endschema %}
