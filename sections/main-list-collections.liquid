<div class="container section">
  <div class="section-head">
    <h1>{{ section.settings.heading }}</h1>
  </div>
  <div class="grid grid--3">
    {%- for collection in collections -%}
      <article class="article-card">
        <div class="article-card__media">
          {%- if collection.featured_image -%}
            <img
              src="{{ collection.featured_image | image_url: width: 700 }}"
              width="700" height="394" loading="lazy"
              alt="{{ collection.featured_image.alt | default: collection.title | escape }}"
            >
          {%- else -%}
            {% render 'ph-image', label: collection.title, ratio: '16x9' %}
          {%- endif -%}
        </div>
        <div class="article-card__body">
          <h2 class="article-card__title"><a href="{{ collection.url }}">{{ collection.title }}</a></h2>
          <p class="small muted">{{ collection.products_count }} products</p>
        </div>
      </article>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" }
  ]
}
{% endschema %}
