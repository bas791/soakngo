{%- comment -%}
  "Soak n Go vs the others" comparison table. Rows are blocks, fully
  editable. Competitor columns compare on product-category characteristics
  ("bleach-based cleaners", "spray-on concentrates") so every claim is
  factual and defensible; the column names are settings.
{%- endcomment -%}
<section class="section{% if section.settings.soft_background %} section--soft{% endif %}" id="comparison">
  <div class="container">
    <div class="section-head section-head--center">
      {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="lede">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>

    <div class="compare-wrap">
      <table class="compare-table">
        <caption class="visually-hidden">{{ section.settings.heading }}</caption>
        <thead>
          <tr>
            <th scope="col"><span class="visually-hidden">Feature</span></th>
            <th scope="col" class="col-us">{{ section.settings.col_us }}</th>
            <th scope="col">{{ section.settings.col_a }}</th>
            <th scope="col">{{ section.settings.col_b }}</th>
          </tr>
        </thead>
        <tbody>
          {%- assign row_limit = section.blocks.size -%}
          {%- if section.settings.teaser_rows > 0 and section.settings.teaser_rows < row_limit -%}
            {%- assign row_limit = section.settings.teaser_rows -%}
          {%- endif -%}
          {%- for block in section.blocks limit: row_limit -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.label }}</th>
              <td class="col-us">
                {%- if block.settings.us == 'tick' -%}
                  <span class="compare-tick">{% render 'icon', name: 'tick', size: 20 %}<span class="visually-hidden">Yes</span></span>
                {%- elsif block.settings.us == 'cross' -%}
                  <span class="compare-cross">{% render 'icon', name: 'cross', size: 20 %}<span class="visually-hidden">No</span></span>
                {%- else -%}
                  {{ block.settings.us_text }}
                {%- endif -%}
              </td>
              <td>
                {%- if block.settings.a == 'tick' -%}
                  <span class="compare-tick">{% render 'icon', name: 'tick', size: 20 %}<span class="visually-hidden">Yes</span></span>
                {%- elsif block.settings.a == 'cross' -%}
                  <span class="compare-cross">{% render 'icon', name: 'cross', size: 20 %}<span class="visually-hidden">No</span></span>
                {%- else -%}
                  {{ block.settings.a_text }}
                {%- endif -%}
              </td>
              <td>
                {%- if block.settings.b == 'tick' -%}
                  <span class="compare-tick">{% render 'icon', name: 'tick', size: 20 %}<span class="visually-hidden">Yes</span></span>
                {%- elsif block.settings.b == 'cross' -%}
                  <span class="compare-cross">{% render 'icon', name: 'cross', size: 20 %}<span class="visually-hidden">No</span></span>
                {%- else -%}
                  {{ block.settings.b_text }}
                {%- endif -%}
              </td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>

    {%- if section.settings.footnote != blank -%}
      <p class="compare-note">{{ section.settings.footnote }}</p>
    {%- endif -%}

    {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
      <p class="text-center" style="margin-top: var(--space-5);">
        <a href="{{ section.settings.cta_link }}" class="btn {% if section.settings.cta_primary %}btn--primary{% else %}btn--secondary{% endif %}">{{ section.settings.cta_label }}</a>
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Comparison table",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Do the maths" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Soak n Go vs the others" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "How we stack up against bleach-based fast-acting cleaners and mix-it-yourself spray-on concentrates." },
    { "type": "text", "id": "col_us", "label": "Our column", "default": "Soak n Go" },
    { "type": "text", "id": "col_a", "label": "Competitor column A", "default": "Bleach-based cleaners" },
    { "type": "text", "id": "col_b", "label": "Competitor column B", "default": "Spray-on concentrates" },
    {
      "type": "range",
      "id": "teaser_rows",
      "label": "Teaser mode — rows to show (0 = all)",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 0,
      "info": "Use with a button linking to the full comparison page."
    },
    { "type": "textarea", "id": "footnote", "label": "Footnote", "default": "Category comparison based on typical product characteristics of bleach-based exterior cleaners and spray-on concentrate cleaners available in NZ. Always follow label directions on any product." },
    { "type": "text", "id": "cta_label", "label": "Button label" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "checkbox", "id": "cta_primary", "label": "Yellow button", "default": false },
    { "type": "checkbox", "id": "soft_background", "label": "Soft background", "default": true }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison row",
      "settings": [
        { "type": "text", "id": "label", "label": "Feature", "default": "No bleach" },
        {
          "type": "select",
          "id": "us",
          "label": "Soak n Go",
          "options": [
            { "value": "tick", "label": "Tick" },
            { "value": "cross", "label": "Cross" },
            { "value": "text", "label": "Text" }
          ],
          "default": "tick"
        },
        { "type": "text", "id": "us_text", "label": "Soak n Go text (if Text)" },
        {
          "type": "select",
          "id": "a",
          "label": "Competitor A",
          "options": [
            { "value": "tick", "label": "Tick" },
            { "value": "cross", "label": "Cross" },
            { "value": "text", "label": "Text" }
          ],
          "default": "cross"
        },
        { "type": "text", "id": "a_text", "label": "Competitor A text (if Text)" },
        {
          "type": "select",
          "id": "b",
          "label": "Competitor B",
          "options": [
            { "value": "tick", "label": "Tick" },
            { "value": "cross", "label": "Cross" },
            { "value": "text", "label": "Text" }
          ],
          "default": "cross"
        },
        { "type": "text", "id": "b_text", "label": "Competitor B text (if Text)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison table",
      "blocks": [
        { "type": "row", "settings": { "label": "No bleach", "us": "tick", "a": "cross", "b": "tick" } },
        { "type": "row", "settings": { "label": "No acid", "us": "tick", "a": "cross", "b": "tick" } },
        { "type": "row", "settings": { "label": "No scrubbing", "us": "tick", "a": "text", "a_text": "Sometimes", "b": "tick" } },
        { "type": "row", "settings": { "label": "No rinsing", "us": "tick", "a": "cross", "b": "tick" } },
        { "type": "row", "settings": { "label": "No mixing — clicks onto the hose", "us": "tick", "a": "cross", "b": "cross" } },
        { "type": "row", "settings": { "label": "Keeps working for weeks after you walk away", "us": "tick", "a": "cross", "b": "tick" } },
        { "type": "row", "settings": { "label": "NZ made & owned", "us": "tick", "a": "text", "a_text": "Varies", "b": "text", "b_text": "Varies" } },
        { "type": "row", "settings": { "label": "Made by professional exterior cleaners", "us": "tick", "a": "cross", "b": "cross" } },
        { "type": "row", "settings": { "label": "Subscribe & Save so you never run out", "us": "tick", "a": "cross", "b": "cross" } }
      ]
    }
  ]
}
{% endschema %}
