<div class="container section">
  <div class="section-head">
    {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker }}</p>{%- endif -%}
    <h1>{{ blog.title }}</h1>
    {%- if section.settings.intro != blank -%}<p class="lede">{{ section.settings.intro }}</p>{%- endif -%}
  </div>

  {%- paginate blog.articles by 9 -%}
    <div class="grid grid--3">
      {%- for article in blog.articles -%}
        <article class="article-card">
          <div class="article-card__media">
            {%- if article.image -%}
              <img
                src="{{ article.image | image_url: width: 700 }}"
                srcset="{{ article.image | image_url: width: 400 }} 400w, {{ article.image | image_url: width: 700 }} 700w"
                sizes="(min-width: 750px) 33vw, 100vw"
                width="700" height="394" loading="lazy"
                alt="{{ article.image.alt | default: article.title | escape }}"
              >
            {%- else -%}
              {% render 'ph-image', label: 'BLOG — article hero image', ratio: '16x9' %}
            {%- endif -%}
          </div>
          <div class="article-card__body">
            <h2 class="article-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
            <p class="small muted">{{ article.published_at | date: '%-d %B %Y' }}</p>
            <p>{{ article.excerpt_or_content | strip_html | truncatewords: 26 }}</p>
            <span class="link-arrow">{{ 'blogs.article.read_more' | t }} {% render 'icon', name: 'arrow', size: 16 %}</span>
          </div>
        </article>
      {%- else -%}
        <p class="muted">No articles yet — the first ones are drafted in docs/content/blog/ ready to publish.</p>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pagination">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">{{ 'general.pagination.previous' | t }}</a>{%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a href="{{ part.url }}">{{ part.title }}</a>
          {%- elsif part.title == paginate.current_page -%}
            <span aria-current="page">{{ part.title }}</span>
          {%- else -%}
            <span>{{ part.title }}</span>
          {%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}">{{ 'general.pagination.next' | t }}</a>{%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Blog",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The soak files" },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Straight answers on moss, mould and keeping NZ exteriors clean — from people who do it for a living."
    }
  ]
}
{% endschema %}
