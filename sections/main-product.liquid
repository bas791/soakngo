{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id
  assign coverage = product.metafields.soakngo.coverage_m2.value
  assign litres = product.metafields.soakngo.volume_litres.value
-%}

<div class="container">
  <div class="product-layout">
    <div class="product-layout__media">
      <product-gallery class="product-gallery">
        <div class="product-gallery__main media-frame" data-gallery-main>
          {%- if product.featured_media -%}
            <img
              src="{{ product.featured_media | image_url: width: 1000 }}"
              srcset="{{ product.featured_media | image_url: width: 600 }} 600w, {{ product.featured_media | image_url: width: 1000 }} 1000w, {{ product.featured_media | image_url: width: 1400 }} 1400w"
              sizes="(min-width: 900px) 50vw, 100vw"
              width="1000"
              height="1000"
              alt="{{ product.featured_media.alt | default: product.title | escape }}"
              fetchpriority="high"
            >
          {%- else -%}
            {% render 'ph-image', label: 'PRODUCT — bottle on white', ratio: '1x1' %}
          {%- endif -%}
        </div>

        {%- if product.media.size > 1 -%}
          <div class="product-gallery__thumbs" role="list">
            {%- for media in product.media -%}
              <button
                type="button"
                class="product-gallery__thumb"
                data-gallery-thumb
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-label="View image {{ forloop.index }} of {{ product.media.size }}"
              >
                <img
                  src="{{ media | image_url: width: 144 }}"
                  width="72"
                  height="72"
                  loading="lazy"
                  alt="{{ media.alt | default: product.title | escape }}"
                >
                <template>
                  <img
                    src="{{ media | image_url: width: 1000 }}"
                    srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 1000 }} 1000w"
                    sizes="(min-width: 900px) 50vw, 100vw"
                    width="1000"
                    height="1000"
                    alt="{{ media.alt | default: product.title | escape }}"
                  >
                </template>
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_before_after -%}
          {%- assign ba_before = product.metafields.soakngo.before_image -%}
          {%- assign ba_after = product.metafields.soakngo.after_image -%}
          <before-after class="ba-slider" style="margin-top: var(--space-3); aspect-ratio: 16/10;">
            <div class="ba-slider__before">
              {%- if ba_before != blank -%}
                <img src="{{ ba_before | image_url: width: 1000 }}" width="1000" height="625" loading="lazy" alt="Before: {{ product.title | escape }}">
              {%- else -%}
                {% render 'ph-image', label: 'BEFORE — grimy surface, same angle', ratio: '16x9', tone: 'navy' %}
              {%- endif -%}
            </div>
            <div class="ba-slider__after">
              {%- if ba_after != blank -%}
                <img src="{{ ba_after | image_url: width: 1000 }}" width="1000" height="625" loading="lazy" alt="After: {{ product.title | escape }}">
              {%- else -%}
                {% render 'ph-image', label: 'AFTER — clean surface, same angle', ratio: '16x9' %}
              {%- endif -%}
            </div>
            <span class="ba-slider__label ba-slider__label--before">Before</span>
            <span class="ba-slider__label ba-slider__label--after">After</span>
            <div class="ba-slider__handle"></div>
            <label class="visually-hidden" for="BA-{{ section.id }}">{{ 'accessibility.before_after_handle' | t }}</label>
            <input id="BA-{{ section.id }}" class="ba-slider__range" type="range" min="0" max="100" value="50">
          </before-after>
        {%- endif -%}
      </product-gallery>
    </div>

    <div class="product-info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when '@app' -%}
            {% render block %}

          {%- when 'kicker' -%}
            <p class="kicker" style="margin-bottom:0;" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>

          {%- when 'title' -%}
            <h1 class="product-info__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>

          {%- when 'price' -%}
            <div class="product-info__price-row" {{ block.shopify_attributes }}>
              <span class="price" data-main-price="{{ product.id }}">{{ variant.price | money }}</span>
              {%- if product.compare_at_price > product.price -%}
                <span class="price--compare">{{ product.compare_at_price | money }}</span>
              {%- endif -%}
              {%- if litres and litres > 0 -%}
                {%- assign per_litre = variant.price | divided_by: litres | money -%}
                <span class="price-per-litre">{{ 'products.product.per_litre' | t: price: per_litre }}</span>
              {%- endif -%}
            </div>

          {%- when 'coverage' -%}
            {%- if coverage -%}
              <p class="product-coverage-line" {{ block.shopify_attributes }}>
                {% render 'icon', name: 'droplet', size: 18 %}
                {%- assign coverage_str = coverage | append: '' -%}
                {{ 'products.product.covers_up_to' | t: area: coverage_str }}
              </p>
            {%- endif -%}

          {%- when 'text' -%}
            <div {{ block.shopify_attributes }}>{{ block.settings.richtext }}</div>

          {%- when 'ladder' -%}
            {%- if block.settings.products.count > 0 -%}
              <div {{ block.shopify_attributes }}>
                <h2 class="h4" style="margin-bottom: var(--space-2);">{{ block.settings.heading }}</h2>
                <div class="value-ladder">
                  {%- for ladder_product in block.settings.products -%}
                    {%- liquid
                      assign l_litres = ladder_product.metafields.soakngo.volume_litres.value
                      assign l_coverage = ladder_product.metafields.soakngo.coverage_m2.value
                      assign is_current = false
                      if ladder_product.id == product.id
                        assign is_current = true
                      endif
                    -%}
                    {%- if is_current -%}
                      <span class="value-ladder__item is-current" aria-current="true">
                        <span class="value-ladder__flag badge badge--navy">You're here</span>
                    {%- else -%}
                      <a class="value-ladder__item" href="{{ ladder_product.url }}">
                    {%- endif -%}
                      <span>
                        <span class="value-ladder__name">{{ ladder_product.title }}</span>
                        {%- if l_coverage -%}
                          <span class="value-ladder__sub">Covers up to {{ l_coverage }} m²</span>
                        {%- endif -%}
                      </span>
                      <span class="value-ladder__price">
                        {{ ladder_product.price | money }}
                        {%- if l_litres and l_litres > 0 -%}
                          {%- assign l_per_litre = ladder_product.price | divided_by: l_litres | money -%}
                          <span class="price-per-litre">{{ 'products.product.per_litre' | t: price: l_per_litre }}</span>
                        {%- endif -%}
                      </span>
                    {%- if is_current -%}</span>{%- else -%}</a>{%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}

          {%- when 'selling_plan' -%}
            <div {{ block.shopify_attributes }}>
              {% render 'selling-plan-picker', product: product, subscribe_default: block.settings.subscribe_default, form_id: form_id %}
            </div>

          {%- when 'bundler' -%}
            <div {{ block.shopify_attributes }}>
              {% render 'bundler-block', product: product %}
            </div>

          {%- when 'quantity' -%}
            <div {{ block.shopify_attributes }}>
              <label class="small" style="font-weight:600; display:block; margin-bottom: var(--space-1);" for="Qty-{{ section.id }}">
                {{ 'products.product.quantity' | t }}
              </label>
              <quantity-input class="qty">
                <button type="button" data-qty-change="decrement" aria-label="{{ 'accessibility.decrease_quantity' | t }}">
                  {% render 'icon', name: 'minus', size: 16 %}
                </button>
                <input id="Qty-{{ section.id }}" type="number" name="quantity" value="1" min="1" inputmode="numeric" form="{{ form_id }}">
                <button type="button" data-qty-change="increment" aria-label="{{ 'accessibility.increase_quantity' | t }}">
                  {% render 'icon', name: 'plus', size: 16 %}
                </button>
              </quantity-input>
            </div>

          {%- when 'buy_buttons' -%}
            <div id="BuyButtons-{{ section.id }}" {{ block.shopify_attributes }}>
              <product-form>
                {%- form 'product', product, id: form_id -%}
                  {%- if product.variants.size > 1 -%}
                    <div class="field">
                      <label for="Variant-{{ section.id }}">Option</label>
                      <select id="Variant-{{ section.id }}" name="id" class="input">
                        {%- for v in product.variants -%}
                          <option value="{{ v.id }}" {% if v == variant %}selected{% endif %} {% unless v.available %}disabled{% endunless %}>
                            {{ v.title }} — {{ v.price | money }}{% unless v.available %} ({{ 'products.product.sold_out' | t }}){% endunless %}
                          </option>
                        {%- endfor -%}
                      </select>
                    </div>
                  {%- else -%}
                    <input type="hidden" name="id" value="{{ variant.id }}">
                  {%- endif -%}
                  <button
                    type="submit"
                    name="add"
                    class="btn btn--primary btn--full btn--large"
                    data-adding-text="{{ 'products.product.adding' | t }}"
                    {% unless variant.available %}disabled{% endunless %}
                  >
                    <span data-atc-text>
                      {%- if variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
                    </span>
                  </button>
                {%- endform -%}
              </product-form>
              {%- if block.settings.show_express -%}
                <div class="additional-checkout-buttons" aria-label="Express checkout">
                  {{ content_for_additional_checkout_buttons }}
                </div>
              {%- endif -%}
            </div>

          {%- when 'coverage_calc' -%}
            {%- if block.settings.products.count > 0 -%}
              <coverage-calculator class="calc" {{ block.shopify_attributes }}>
                <h3 class="h4" style="margin-bottom: var(--space-3);">{{ block.settings.heading }}</h3>
                <script type="application/json" data-coverage-data>
                  [
                    {%- for calc_product in block.settings.products -%}
                      {%- assign c = calc_product.metafields.soakngo.coverage_m2.value | default: 0 -%}
                      {
                        "title": {{ calc_product.title | json }},
                        "url": {{ calc_product.url | json }},
                        "coverage": {{ c }},
                        "price": {{ calc_product.price }}
                      }{%- unless forloop.last -%},{%- endunless -%}
                    {%- endfor -%}
                  ]
                </script>
                <div class="calc__row">
                  <div class="field">
                    <label for="CoverageInput-{{ section.id }}">{{ block.settings.input_label }}</label>
                    <input id="CoverageInput-{{ section.id }}" type="number" min="1" inputmode="numeric" placeholder="e.g. 180" data-coverage-input>
                  </div>
                  <button type="button" class="btn btn--navy" data-coverage-submit>{{ block.settings.button_label }}</button>
                </div>
                <p class="calc__unit-hint">{{ block.settings.hint }}</p>
                <div class="calc__result" data-coverage-result hidden aria-live="polite">
                  <p class="calc__result-headline" data-coverage-pick></p>
                  <p data-coverage-note></p>
                  <a href="#" class="link-arrow" data-coverage-link>See it {% render 'icon', name: 'arrow', size: 16 %}</a>
                </div>
              </coverage-calculator>
            {%- endif -%}

          {%- when 'trust_row' -%}
            <div class="trust-row" {{ block.shopify_attributes }}>
              <span class="trust-row__item">
                {% render 'icon', name: 'truck', size: 20 %}
                <span>{{ block.settings.item_1_title }}<small>{{ block.settings.item_1_text }}</small></span>
              </span>
              <span class="trust-row__item">
                {% render 'icon', name: 'shield', size: 20 %}
                <span>{{ settings.guarantee_heading }}<small>{{ settings.guarantee_text }}</small></span>
              </span>
              <span class="trust-row__item">
                {% render 'icon', name: 'pin', size: 20 %}
                <span>{{ block.settings.item_3_title }}<small>{{ block.settings.item_3_text }}</small></span>
              </span>
            </div>

          {%- when 'accordion' -%}
            <details class="faq-item" {{ block.shopify_attributes }} {% if block.settings.open_default %}open{% endif %}>
              <summary>
                {{ block.settings.heading }}
                {% render 'icon', name: 'chevron', size: 20 %}
              </summary>
              <div class="faq-item__answer">
                {{ block.settings.content }}
                {%- if block.settings.link_label != blank and block.settings.link != blank -%}
                  <p><a href="{{ block.settings.link }}" class="link-arrow">{{ block.settings.link_label }} {% render 'icon', name: 'arrow', size: 16 %}</a></p>
                {%- endif -%}
              </div>
            </details>

          {%- when 'description' -%}
            <details class="faq-item" {{ block.shopify_attributes }} {% if block.settings.open_default %}open{% endif %}>
              <summary>
                {{ block.settings.heading }}
                {% render 'icon', name: 'chevron', size: 20 %}
              </summary>
              <div class="faq-item__answer">{{ product.description }}</div>
            </details>

        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- comment -%} Sticky add-to-cart, mobile only. Submits the main product form. {%- endcomment -%}
{%- if section.settings.show_sticky_atc -%}
  <sticky-atc data-watch="BuyButtons-{{ section.id }}">
    <div class="sticky-atc" aria-hidden="false">
      <div class="sticky-atc__info">
        <p class="sticky-atc__title">{{ product.title }}</p>
        <p class="sticky-atc__price" data-main-price="{{ product.id }}">{{ variant.price | money }}</p>
      </div>
      <button type="submit" form="{{ form_id }}" class="btn btn--primary" {% unless variant.available %}disabled{% endunless %}>
        <span data-atc-text>
          {%- if variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
        </span>
      </button>
    </div>
  </sticky-atc>
{%- endif -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ request.origin | append: product.url | json }},
  {% if product.featured_media %}"image": [{{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }}],{% endif %}
  "description": {{ product.description | strip_html | truncatewords: 80 | json }},
  "brand": { "@type": "Brand", "name": {{ product.vendor | default: shop.name | json }} },
  {% if variant.sku != blank %}"sku": {{ variant.sku | json }},{% endif %}
  "offers": {
    "@type": "Offer",
    "url": {{ request.origin | append: product.url | json }},
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": {{ product.price | divided_by: 100.0 | json }},
    "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
    "seller": { "@type": "Organization", "name": {{ shop.name | json }} }
  }
}
</script>

{% schema %}
{
  "name": "Product page",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_before_after",
      "label": "Show before/after slider under gallery",
      "info": "Uses the soakngo.before_image and soakngo.after_image product metafields, with labelled placeholders until photos are added.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sticky_atc",
      "label": "Sticky add-to-cart on mobile",
      "default": true
    }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "kicker",
      "name": "Kicker line",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "No acid, no bleach, no scrub, no rinse" }
      ]
    },
    { "type": "title", "name": "Title", "limit": 1, "settings": [] },
    { "type": "price", "name": "Price", "limit": 1, "settings": [] },
    { "type": "coverage", "name": "Coverage line", "limit": 1, "settings": [] },
    {
      "type": "text",
      "name": "Rich text",
      "settings": [
        { "type": "richtext", "id": "richtext", "label": "Text", "default": "<p>Click it onto the hose, soak the surface, walk away. The weather does the slow work — moss, mould and grime fade over the following weeks.</p>" }
      ]
    },
    {
      "type": "ladder",
      "name": "Size value ladder",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Pick your size" },
        { "type": "product_list", "id": "products", "label": "Products (smallest to largest)", "limit": 4 }
      ]
    },
    {
      "type": "selling_plan",
      "name": "Subscribe & Save picker",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "subscribe_default",
          "label": "Select subscription by default",
          "info": "On for the Refill template, off for one-off sizes.",
          "default": false
        }
      ]
    },
    { "type": "bundler", "name": "Bundler multi-buy block", "limit": 1, "settings": [] },
    { "type": "quantity", "name": "Quantity selector", "limit": 1, "settings": [] },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_express", "label": "Show express checkout buttons", "default": true }
      ]
    },
    {
      "type": "coverage_calc",
      "name": "Coverage calculator",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "How big is the job?" },
        { "type": "text", "id": "input_label", "label": "Input label", "default": "Rough area in square metres" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Tell me what I need" },
        { "type": "text", "id": "hint", "label": "Hint", "default": "An average single-storey 3-bedroom house exterior is roughly 150–200 m²." },
        { "type": "product_list", "id": "products", "label": "Products to recommend from", "limit": 4 }
      ]
    },
    {
      "type": "trust_row",
      "name": "Trust row",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "item_1_title", "label": "Delivery title", "default": "Fast NZ-wide delivery" },
        { "type": "text", "id": "item_1_text", "label": "Delivery text", "default": "Free over $79. 2–4 working days." },
        { "type": "text", "id": "item_3_title", "label": "Origin title", "default": "NZ made & owned" },
        { "type": "text", "id": "item_3_text", "label": "Origin text", "default": "Made by the pros who wash buildings for a living." }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "How it compares" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Bleach-based cleaners work fast, then you rinse the result down the garden. Soak n Go works with the weather instead: no bleach, no acid, safe around plants when used as directed, and the result keeps improving for weeks.</p>" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "See the full comparison" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "open_default", "label": "Open by default", "default": false }
      ]
    },
    {
      "type": "description",
      "name": "Product description",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "What it is & how to use it" },
        { "type": "checkbox", "id": "open_default", "label": "Open by default", "default": true }
      ]
    }
  ]
}
{% endschema %}
