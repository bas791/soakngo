<section class="section{% if section.settings.navy_style %} section--navy{% else %} section--soft{% endif %}">
  <div class="container container--narrow text-center">
    {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker }}</p>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    <p class="lede" style="margin: var(--space-3) auto var(--space-5);">{{ section.settings.text }}</p>
    {%- form 'customer', class: 'newsletter-form', style: 'margin-inline: auto; justify-content: center;' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="field">
        <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'newsletter.label' | t }}</label>
        <input
          id="NewsletterEmail-{{ section.id }}"
          type="email"
          name="contact[email]"
          class="input"
          value="{{ form.email }}"
          placeholder="{{ 'newsletter.placeholder' | t }}"
          required
          autocomplete="email"
        >
      </div>
      <button type="submit" class="btn btn--primary">{{ section.settings.button_label }}</button>
      {%- if form.posted_successfully? -%}
        <p class="form-status form-status--success" style="flex-basis:100%;">{{ 'newsletter.success' | t }}</p>
      {%- elsif form.errors -%}
        <p class="form-status form-status--error" style="flex-basis:100%;">{{ 'newsletter.error' | t }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Email capture",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Stay ahead of the green" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get the once-a-year reminder" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "One email each spring to remind you it's soak time, plus the occasional deal. No spam — we're too busy washing buildings."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Sign me up" },
    { "type": "checkbox", "id": "navy_style", "label": "Navy style", "default": false }
  ],
  "presets": [{ "name": "Email capture" }]
}
{% endschema %}
