<section class="section{% if section.settings.soft_background %} section--soft{% endif %}{% if section.settings.navy_style %} section--navy{% endif %}">
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.kicker != blank -%}
      <div class="section-head{% if section.settings.centre_heading %} section-head--center{% endif %}">
        {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<p class="lede">{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="grid grid--{{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        <div class="step-card" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}
            <span class="step-card__number" aria-hidden="true" style="background: var(--color-bg-soft); color: var(--color-secondary);">
              {% render 'icon', name: block.settings.icon, size: 26 %}
            </span>
          {%- endif -%}
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Multicolumn",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What we stand for" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "checkbox", "id": "centre_heading", "label": "Centre heading", "default": true },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns (desktop)",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    { "type": "checkbox", "id": "soft_background", "label": "Soft background", "default": false },
    { "type": "checkbox", "id": "navy_style", "label": "Navy style", "default": false }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "shield", "label": "Shield" },
            { "value": "pin", "label": "Map pin" },
            { "value": "droplet", "label": "Droplet" },
            { "value": "clock", "label": "Clock" },
            { "value": "truck", "label": "Truck" },
            { "value": "refresh", "label": "Refresh" },
            { "value": "hose", "label": "Hose" },
            { "value": "tick", "label": "Tick" },
            { "value": "star", "label": "Star" }
          ],
          "default": "tick"
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "No nasty chemicals" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "No acid, no bleach, no chlorine. Clean without dousing the place in bleach every spring." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Multicolumn",
      "blocks": [
        { "type": "column", "settings": { "icon": "leaf", "heading": "No nasty chemicals", "text": "No acid, no bleach, no chlorine. Clean without dousing the place in bleach every spring." } },
        { "type": "column", "settings": { "icon": "pin", "heading": "NZ made & owned", "text": "Formulated, bottled and shipped right here. The weather it works with is ours too." } },
        { "type": "column", "settings": { "icon": "shield", "heading": "Made by the pros", "text": "Built by Maximum Wash — a professional exterior cleaning company. We know what clean looks like." } }
      ]
    }
  ]
}
{% endschema %}
