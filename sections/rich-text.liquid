<section class="section{% if section.settings.soft_background %} section--soft{% endif %}{% if section.settings.navy_style %} section--navy{% endif %}">
  <div class="container container--narrow{% if section.settings.centre %} text-center{% endif %}">
    {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 style="margin-bottom: var(--space-4);">{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="lede" style="margin-inline: auto;">{{ section.settings.content }}</div>
    {%- if section.settings.cta_label != blank -%}
      <p style="margin-top: var(--space-5);">
        <a href="{{ section.settings.cta_link }}" class="btn {% if section.settings.cta_primary %}btn--primary{% else %}btn--secondary{% endif %}">{{ section.settings.cta_label }}</a>
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A word from us" },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>We wash buildings for a living. This is the product we'd use at home.</p>"
    },
    { "type": "text", "id": "cta_label", "label": "Button label" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "checkbox", "id": "cta_primary", "label": "Yellow button", "default": true },
    { "type": "checkbox", "id": "centre", "label": "Centre content", "default": true },
    { "type": "checkbox", "id": "soft_background", "label": "Soft background", "default": false },
    { "type": "checkbox", "id": "navy_style", "label": "Navy style", "default": false }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
