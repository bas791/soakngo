{%- comment -%}
  Standalone coverage calculator section (homepage / collection / landing).
  Recommends the right SKU from the soakngo.coverage_m2 metafield.
{%- endcomment -%}
<section class="section{% if section.settings.navy_style %} section--navy{% endif %}">
  <div class="container container--narrow">
    <div class="section-head section-head--center">
      {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="lede">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>

    {%- if section.settings.products.count > 0 -%}
      <coverage-calculator class="calc{% if section.settings.navy_style %} calc--navy{% endif %}">
        <script type="application/json" data-coverage-data>
          [
            {%- for calc_product in section.settings.products -%}
              {%- assign c = calc_product.metafields.soakngo.coverage_m2.value | default: 0 -%}
              {
                "title": {{ calc_product.title | json }},
                "url": {{ calc_product.url | json }},
                "coverage": {{ c }},
                "price": {{ calc_product.price }}
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        </script>
        <div class="calc__row">
          <div class="field">
            <label for="CoverageInput-{{ section.id }}">{{ section.settings.input_label }}</label>
            <input id="CoverageInput-{{ section.id }}" type="number" min="1" inputmode="numeric" placeholder="e.g. 180" data-coverage-input>
          </div>
          <button type="button" class="btn btn--primary" data-coverage-submit>{{ section.settings.button_label }}</button>
        </div>
        <p class="calc__unit-hint">{{ section.settings.hint }}</p>
        <div class="calc__result" data-coverage-result hidden aria-live="polite">
          <p class="calc__result-headline" data-coverage-pick></p>
          <p data-coverage-note></p>
          <a href="#" class="btn btn--navy" data-coverage-link>{{ section.settings.result_cta }}</a>
        </div>
      </coverage-calculator>
    {%- else -%}
      <p class="text-center muted">Assign the four SKUs to this calculator in the theme editor (with their coverage metafields set — see METAFIELDS.md).</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Coverage calculator",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "No guesswork" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Which size do you actually need?" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Punch in a rough area and we'll point you at the right bottle. No spreadsheet required." },
    { "type": "text", "id": "input_label", "label": "Input label", "default": "Rough area in square metres" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Tell me what I need" },
    { "type": "text", "id": "hint", "label": "Hint", "default": "An average single-storey 3-bedroom house exterior is roughly 150–200 m². A standard fence panel is about 3.5 m²." },
    { "type": "text", "id": "result_cta", "label": "Result button label", "default": "Grab it" },
    { "type": "product_list", "id": "products", "label": "Products to recommend from", "limit": 4 },
    { "type": "checkbox", "id": "navy_style", "label": "Navy style", "default": false }
  ],
  "presets": [{ "name": "Coverage calculator" }]
}
{% endschema %}
