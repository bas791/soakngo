<section class="{% if section.settings.navy_style %}section--navy{% endif %}" style="padding-block: var(--space-5); border-block: 1px solid var(--color-line);">
  <div class="container">
    <div class="trust-strip" style="justify-content: center; gap: var(--space-3) var(--space-8);">
      {%- if settings.badge_1 != blank -%}<span class="trust-strip__item">{% render 'icon', name: 'pin', size: 18 %}{{ settings.badge_1 }}</span>{%- endif -%}
      {%- if settings.badge_2 != blank -%}<span class="trust-strip__item">{% render 'icon', name: 'leaf', size: 18 %}{{ settings.badge_2 }}</span>{%- endif -%}
      {%- if settings.badge_3 != blank -%}<span class="trust-strip__item">{% render 'icon', name: 'shield', size: 18 %}{{ settings.badge_3 }}</span>{%- endif -%}
      {%- if settings.badge_4 != blank -%}<span class="trust-strip__item">{% render 'icon', name: 'truck', size: 18 %}{{ settings.badge_4 }}</span>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust badges",
  "settings": [
    {
      "type": "paragraph",
      "content": "Badge text is set once in Theme settings → Trust badges, so it stays consistent everywhere."
    },
    { "type": "checkbox", "id": "navy_style", "label": "Navy style", "default": false }
  ],
  "presets": [{ "name": "Trust badges" }]
}
{% endschema %}
